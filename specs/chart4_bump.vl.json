{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "config": {
    "font": "Inter",
    "view": {
      "stroke": null
    },
    "title": {
      "font": "Fraunces",
      "fontSize": 16,
      "anchor": "start",
      "color": "#2b2a33",
      "subtitleColor": "#6b6a75",
      "subtitleFont": "Inter",
      "subtitleFontSize": 12
    },
    "axis": {
      "labelFont": "Inter",
      "titleFont": "Inter",
      "labelColor": "#6b6a75",
      "titleColor": "#6b6a75",
      "domainColor": "#cfcdd6",
      "tickColor": "#cfcdd6",
      "gridColor": "#ecebf0"
    },
    "legend": {
      "labelFont": "Inter",
      "titleFont": "Inter",
      "labelColor": "#6b6a75",
      "titleColor": "#6b6a75"
    },
    "header": {
      "labelFont": "Inter",
      "labelFontSize": 13,
      "labelColor": "#2b2a33",
      "titleFont": "Inter"
    }
  },
  "title": {
    "text": "Which state ranks highest has shifted",
    "subtitle": "Rank of each state by average adult obesity rate (1 = highest rate)"
  },
  "width": 560,
  "height": 520,
  "data": {
    "url": "data/state_summary.csv"
  },
  "transform": [
    {
      "fold": [
        "rank2011",
        "rank2015",
        "rank2019"
      ],
      "as": [
        "k",
        "rank"
      ]
    },
    {
      "calculate": "slice(datum.k, 4)",
      "as": "year"
    }
  ],
  "encoding": {
    "x": {
      "field": "year",
      "type": "ordinal",
      "title": null,
      "axis": {
        "orient": "top",
        "labelFontSize": 13,
        "labelAngle": 0,
        "grid": false
      },
      "scale": {
        "padding": 0.6
      }
    },
    "y": {
      "field": "rank",
      "type": "quantitative",
      "scale": {
        "domain": [
          16,
          0
        ],
        "reverse": false
      },
      "axis": null
    }
  },
  "layer": [
    {
      "mark": {
        "type": "line",
        "strokeWidth": 2.5,
        "opacity": 0.9
      },
      "encoding": {
        "detail": {
          "field": "state"
        },
        "color": {
          "field": "change",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              8
            ],
            "range": [
              "#d9d6e3",
              "#c8553d",
              "#6d1a36"
            ]
          },
          "legend": {
            "title": "Rise (points)"
          }
        }
      }
    },
    {
      "mark": {
        "type": "circle",
        "size": 90
      },
      "encoding": {
        "color": {
          "field": "change",
          "type": "quantitative",
          "legend": null
        },
        "tooltip": [
          {
            "field": "state"
          },
          {
            "field": "year"
          },
          {
            "field": "rank",
            "title": "Rank"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year === '2019'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 10,
        "fontSize": 11,
        "color": "#2b2a33"
      },
      "encoding": {
        "text": {
          "field": "state"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year === '2011'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -10,
        "fontSize": 11,
        "color": "#2b2a33"
      },
      "encoding": {
        "text": {
          "field": "state"
        }
      }
    }
  ]
}