{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "config": {
    "font": "Inter",
    "view": {
      "stroke": null
    },
    "title": {
      "font": "Fraunces",
      "fontSize": 16,
      "anchor": "start",
      "color": "#2b2a33",
      "subtitleColor": "#6b6a75",
      "subtitleFont": "Inter",
      "subtitleFontSize": 12
    },
    "axis": {
      "labelFont": "Inter",
      "titleFont": "Inter",
      "labelColor": "#6b6a75",
      "titleColor": "#6b6a75",
      "domainColor": "#cfcdd6",
      "tickColor": "#cfcdd6",
      "gridColor": "#ecebf0"
    },
    "legend": {
      "labelFont": "Inter",
      "titleFont": "Inter",
      "labelColor": "#6b6a75",
      "titleColor": "#6b6a75"
    },
    "header": {
      "labelFont": "Inter",
      "labelFontSize": 13,
      "labelColor": "#2b2a33",
      "titleFont": "Inter"
    }
  },
  "title": {
    "text": "Where obesity has grown most since 2011",
    "subtitle": "Change in the average adult rate between 2011 and 2019, in percentage points. Labels shown for the larger states."
  },
  "width": 780,
  "height": 255,
  "projection": {
    "type": "mercator",
    "center": [
      109.7,
      3.95
    ],
    "scale": 2300,
    "translate": [
      390,
      128
    ]
  },
  "layer": [
    {
      "data": {
        "url": "data/malaysia_states.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },
      "transform": [
        {
          "lookup": "properties.state",
          "from": {
            "data": {
              "url": "data/state_summary.csv"
            },
            "key": "state",
            "fields": [
              "change",
              "y2011",
              "y2019"
            ]
          }
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "white",
        "strokeWidth": 0.8
      },
      "encoding": {
        "color": {
          "field": "change",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              8
            ],
            "range": [
              "#e6f4f1",
              "#7fc4b8",
              "#2a8c82",
              "#0b4f4a"
            ]
          },
          "legend": {
            "title": "Change (points)",
            "orient": "bottom",
            "gradientLength": 300
          }
        },
        "tooltip": [
          {
            "field": "properties.state",
            "title": "State"
          },
          {
            "field": "y2011",
            "title": "2011 (%)"
          },
          {
            "field": "y2019",
            "title": "2019 (%)"
          },
          {
            "field": "change",
            "title": "Change (points)"
          }
        ]
      }
    },
    {
      "data": {
        "url": "data/state_summary.csv"
      },
      "transform": [
        {
          "filter": "indexof(['Sabah','Sarawak','Pahang','Perak','Johor','Kelantan','Terengganu','Kedah','Selangor'], datum.state) >= 0"
        },
        {
          "calculate": "(datum.change > 0 ? '+' : '') + datum.change",
          "as": "lab"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": 600,
        "color": "#2b2a33"
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "text": {
          "field": "lab",
          "type": "nominal"
        }
      }
    }
  ]
}