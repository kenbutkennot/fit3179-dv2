{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "config": {
    "font": "Inter",
    "view": {
      "stroke": null
    },
    "title": {
      "font": "Fraunces",
      "fontSize": 16,
      "anchor": "start",
      "color": "#2b2a33",
      "subtitleColor": "#6b6a75",
      "subtitleFont": "Inter",
      "subtitleFontSize": 12
    },
    "axis": {
      "labelFont": "Inter",
      "titleFont": "Inter",
      "labelColor": "#6b6a75",
      "titleColor": "#6b6a75",
      "domainColor": "#cfcdd6",
      "tickColor": "#cfcdd6",
      "gridColor": "#ecebf0"
    },
    "legend": {
      "labelFont": "Inter",
      "titleFont": "Inter",
      "labelColor": "#6b6a75",
      "titleColor": "#6b6a75"
    },
    "header": {
      "labelFont": "Inter",
      "labelFontSize": 13,
      "labelColor": "#2b2a33",
      "titleFont": "Inter"
    }
  },
  "title": {
    "text": "National picture by age and sex, 2019",
    "subtitle": "The gap between women and men is widest among those aged 45 to 64"
  },
  "data": {
    "url": "data/obesity_adults.csv"
  },
  "transform": [
    {
      "filter": "toNumber(datum.year) === 2019 && datum.state === 'MALAYSIA'"
    }
  ],
  "hconcat": [
    {
      "title": {
        "text": "Men",
        "anchor": "middle"
      },
      "width": 260,
      "height": 180,
      "transform": [
        {
          "filter": "datum.sex === 'Men'"
        }
      ],
      "layer": [
        {
          "mark": {
            "type": "bar",
            "color": "#2f6f9f"
          },
          "encoding": {
            "x": {
              "field": "pct",
              "type": "quantitative",
              "scale": {
                "domain": [
                  0,
                  32
                ],
                "reverse": true
              },
              "title": "% of adults with obesity"
            },
            "y": {
              "field": "age",
              "type": "ordinal",
              "title": null,
              "axis": {
                "orient": "right"
              },
              "sort": [
                "65+",
                "45-64",
                "25-44",
                "18-24"
              ]
            }
          }
        },
        {
          "mark": {
            "type": "text",
            "dx": -14,
            "fontSize": 11,
            "color": "#2b2a33"
          },
          "encoding": {
            "x": {
              "field": "pct",
              "type": "quantitative"
            },
            "y": {
              "field": "age",
              "type": "ordinal",
              "sort": [
                "65+",
                "45-64",
                "25-44",
                "18-24"
              ]
            },
            "text": {
              "field": "pct",
              "type": "quantitative",
              "format": ".1f"
            }
          }
        }
      ]
    },
    {
      "title": {
        "text": "Women",
        "anchor": "middle"
      },
      "width": 260,
      "height": 180,
      "transform": [
        {
          "filter": "datum.sex === 'Women'"
        }
      ],
      "layer": [
        {
          "mark": {
            "type": "bar",
            "color": "#c8553d"
          },
          "encoding": {
            "x": {
              "field": "pct",
              "type": "quantitative",
              "scale": {
                "domain": [
                  0,
                  32
                ],
                "reverse": false
              },
              "title": "% of adults with obesity"
            },
            "y": {
              "field": "age",
              "type": "ordinal",
              "title": null,
              "axis": {
                "orient": "left"
              },
              "sort": [
                "65+",
                "45-64",
                "25-44",
                "18-24"
              ]
            }
          }
        },
        {
          "mark": {
            "type": "text",
            "dx": 14,
            "fontSize": 11,
            "color": "#2b2a33"
          },
          "encoding": {
            "x": {
              "field": "pct",
              "type": "quantitative"
            },
            "y": {
              "field": "age",
              "type": "ordinal",
              "sort": [
                "65+",
                "45-64",
                "25-44",
                "18-24"
              ]
            },
            "text": {
              "field": "pct",
              "type": "quantitative",
              "format": ".1f"
            }
          }
        }
      ]
    }
  ],
  "spacing": 24
}